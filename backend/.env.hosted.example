# Hosted multi-vendor AI role routing for Phase Alpha.
# Copy the values you want into backend/.env after you have valid provider keys.

AI_ROLE_ADAPTER_ENABLED=true
AI_ROLE_ROUTER_ENABLED=true
AI_ROLE_REQUIRE_SUCCESS=false
AI_ROLE_TIMEOUT_SECONDS=45
AI_ROLE_TEMPERATURE=0.1
AI_ROLE_MAX_TOKENS=1400

# Optional control plane metadata
AI_ROLE_GATEWAY_ENABLED=false
AI_ROLE_GATEWAY_BASE_URL=

# Role routing policy
AI_ROLE_ROUTE_DEFAULT=gemini_flash_lite,groq
AI_ROLE_ROUTE_TECHNICAL=gemini_flash_lite,groq
AI_ROLE_ROUTE_FUNDAMENTAL=gemini_flash_lite,groq
AI_ROLE_ROUTE_SENTIMENT=gemini_flash_lite,groq
AI_ROLE_ROUTE_ML=gemini_flash,groq
AI_ROLE_ROUTE_INSIGHT=gemini_flash_lite,groq
AI_ROLE_ROUTE_HEDGE_FUND=gemini_flash,groq
AI_ROLE_ROUTE_FUND_MANAGER=gemini_flash,groq
AI_ROLE_ROUTE_COMPOSITE_SYNTHESIS=gemini_flash,groq
AI_ROLE_ROUTE_RESEARCH_JUDGE=gemini_flash,groq
AI_ROLE_ROUTE_BLOG=gemini_flash,groq

# Gemini worker rail
AI_ROLE_PROVIDER_GEMINI_FLASH_LITE_ENABLED=true
AI_ROLE_PROVIDER_GEMINI_FLASH_LITE_TYPE=openai_compatible
AI_ROLE_PROVIDER_GEMINI_FLASH_LITE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_ROLE_PROVIDER_GEMINI_FLASH_LITE_API_KEY=
AI_ROLE_PROVIDER_GEMINI_FLASH_LITE_MODEL=gemini-2.5-flash-lite

# Gemini planner / synthesis rail
AI_ROLE_PROVIDER_GEMINI_FLASH_ENABLED=true
AI_ROLE_PROVIDER_GEMINI_FLASH_TYPE=openai_compatible
AI_ROLE_PROVIDER_GEMINI_FLASH_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_ROLE_PROVIDER_GEMINI_FLASH_API_KEY=
AI_ROLE_PROVIDER_GEMINI_FLASH_MODEL=gemini-2.5-flash

# Groq low-latency fallback rail
AI_ROLE_PROVIDER_GROQ_ENABLED=true
AI_ROLE_PROVIDER_GROQ_TYPE=openai_compatible
AI_ROLE_PROVIDER_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_ROLE_PROVIDER_GROQ_API_KEY=
AI_ROLE_PROVIDER_GROQ_MODEL=gpt-oss-20b

# Optional GitHub Models overflow / experimentation rail
AI_ROLE_PROVIDER_GITHUB_MODELS_ENABLED=false
AI_ROLE_PROVIDER_GITHUB_MODELS_TYPE=openai_compatible
AI_ROLE_PROVIDER_GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
AI_ROLE_PROVIDER_GITHUB_MODELS_API_KEY=
AI_ROLE_PROVIDER_GITHUB_MODELS_MODEL=gpt-4.1-mini
