# Environment
ENV=dev
DETERMINISTIC_RUNTIME_MODE=true
REAL_DATA_STRICT_MODE=true

# Auth
SECRET_KEY=dev-secret
API_KEY=dev-api-key
OPENCLAW_INGEST_TOKEN=replace_with_long_random_token
OPENCLAW_COMMANDS_ENABLED=false
# Optional: if empty, OPENCLAW_INGEST_TOKEN is reused for command auth.
OPENCLAW_COMMAND_TOKEN=
OPENCLAW_COMMAND_DEFAULT_AGENT_ID=ceo
# Comma-separated Discord channel IDs or names.
OPENCLAW_COMMAND_CHANNEL_ALLOWLIST=vektor-ceo
# Optional comma-separated sender IDs or names.
OPENCLAW_COMMAND_SENDER_ALLOWLIST=
OPENCLAW_COMMAND_ROLE_ALLOWLIST=technical_analyst,fundamental_analyst,sentiment_analyst,ml_timeseries_analyst,insight_researcher,hedge_fund_researcher,fund_manager,trader,risk_auditor,signal_swarm,blog_writer
# Syntax: channel=role1,role2;channel2=roleA,roleB
OPENCLAW_COMMAND_CHANNEL_ROLE_POLICIES=vektor-ceo=technical_analyst,fundamental_analyst,sentiment_analyst,ml_timeseries_analyst,insight_researcher,hedge_fund_researcher,fund_manager,trader,risk_auditor,signal_swarm,blog_writer
OPENCLAW_COMMAND_MAX_TEXT_LENGTH=4000
OPENCLAW_FUND_MANAGER_MODE=false
OPENCLAW_FUND_MANAGER_AGENT_ID=fund_manager
OPENCLAW_FUND_MANAGER_ASSIGNED_ROLES=technical_analyst,fundamental_analyst,sentiment_analyst,ml_timeseries_analyst,insight_researcher,hedge_fund_researcher
KNOWLEDGE_GRAPH_ENABLED=true
KNOWLEDGE_GRAPH_DIR=knowledge_graph
KNOWLEDGE_GRAPH_MAX_EVENTS=50000
KNOWLEDGE_GRAPH_PERSIST=true
GRAPHIFY_SYNC_ENABLED=false
GRAPHIFY_SYNC_MIN_INTERVAL_SECONDS=30
# Uses your existing local Graphify install when sync is enabled.
GRAPHIFY_UPDATE_COMMAND=py -3 -m graphify update .

# AI specialist role adapter (LLM-driven analyst reports)
AI_ROLE_ADAPTER_ENABLED=false
AI_ROLE_ROUTER_ENABLED=false
AI_ROLE_GATEWAY_ENABLED=false
AI_ROLE_PROVIDER=openai_compatible
AI_ROLE_API_BASE_URL=https://api.openai.com/v1
AI_ROLE_API_KEY=
AI_ROLE_TIMEOUT_SECONDS=20
AI_ROLE_TEMPERATURE=0.1
AI_ROLE_MAX_TOKENS=700
AI_ROLE_MODEL_DEFAULT=gpt-4.1-mini
AI_ROLE_MODEL_TECHNICAL=
AI_ROLE_MODEL_FUNDAMENTAL=
AI_ROLE_MODEL_SENTIMENT=
AI_ROLE_MODEL_ML=
AI_ROLE_MODEL_INSIGHT=
AI_ROLE_MODEL_HEDGE_FUND=
AI_ROLE_MODEL_BLOG=
AI_ROLE_REQUIRE_SUCCESS=false
AI_ROLE_PROVIDER_GEMINI_FLASH_LITE_ENABLED=false
AI_ROLE_PROVIDER_GEMINI_FLASH_ENABLED=false
AI_ROLE_PROVIDER_GROQ_ENABLED=false
AI_ROLE_PROVIDER_GITHUB_MODELS_ENABLED=false
BLOG_AUTO_EDITORIAL_ENABLED=false
BLOG_AUTO_EDITORIAL_INTERVAL_HOURS=12
BLOG_AUTO_EDITORIAL_TARGET_PER_DAY=2
BLOG_AUTO_EDITORIAL_MIN_CONFIDENCE=0.55

# Database
DB_BACKEND=sqlite
SQLITE_PATH=trading_bot.db
# For hosted Postgres set DB_BACKEND=postgres and provide a credentialed URL.
# Example: postgresql://vektor:<password>@<host>:5432/vektor
DATABASE_URL=
FRONTEND_URL=http://localhost:5173
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Quant data pipeline
DATA_PIPELINE_ENABLED=true
DATA_PIPELINE_INTERVAL_SECONDS=60
# Empty uses AGENT_RUNTIME_AUTOPILOT_SCOUT_SYMBOLS as the ingestion universe.
DATA_PIPELINE_SYMBOLS=
DATA_PIPELINE_HISTORY_BARS=260
DATA_PIPELINE_HISTORY_REFRESH_SECONDS=3600
DATA_PIPELINE_FUNDAMENTALS_REFRESH_SECONDS=21600
DATA_PIPELINE_NEWS_LIMIT=12
DATA_PIPELINE_NEWS_STREAM_ENABLED=true
DATA_PIPELINE_MAX_BAR_AGE_DAYS=5
DATA_PIPELINE_MAX_NEWS_AGE_HOURS=72
DATA_PIPELINE_MIN_FEATURE_QUALITY_SCORE=0.75
DATA_PIPELINE_MAX_SPREAD_BPS=100
DATA_PIPELINE_TICK_ESTIMATE_PER_SYMBOL_DAY=390
SENTIMENT_FINBERT_ENABLED=false

# Strategy tunables
BUY_THRESHOLD=0.15
SELL_THRESHOLD=-0.15
ATR_PERIOD=14
VOL_THRESHOLD=0.03
AUTO_TRADING_ENABLED=false
AGENT_RUNTIME_ENABLED=false
AGENT_RUNTIME_POLL_INTERVAL_SECONDS=1.5
AGENT_RUNTIME_AUTOPILOT_ENABLED=false
AGENT_RUNTIME_AUTOPILOT_INTERVAL_SECONDS=120
AGENT_RUNTIME_AUTOPILOT_SYMBOLS=AAPL,MSFT,NVDA,SPY
AGENT_RUNTIME_AUTOPILOT_DYNAMIC_UNIVERSE_ENABLED=true
AGENT_RUNTIME_AUTOPILOT_SCOUT_SYMBOLS=SPY,QQQ,IWM,DIA,XLK,XLF,XLE,TLT,GLD,SLV,USO,UNG,AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AMD
AGENT_RUNTIME_AUTOPILOT_SCOUT_MAX_SYMBOLS=4
AGENT_RUNTIME_AUTOPILOT_DEFAULT_SIDE=buy
AGENT_RUNTIME_AUTOPILOT_DEFAULT_QUANTITY=1
AGENT_RUNTIME_AUTOPILOT_SLEEVE=tactical
AGENT_RUNTIME_SESSION_GUARD_ENABLED=true
AGENT_RUNTIME_BLOCK_TRADES_WHEN_CLOSED=true
AGENT_RUNTIME_MIN_TRADE_CONVICTION=0.60
AGENT_RUNTIME_ALLOW_CASH_HOLD=true
FUND_DEFAULT_CAPITAL_USD=500000
FUND_DEFAULT_RESERVE_CASH_USD=50000
FUND_DEFAULT_SLEEVE_WEIGHTS=long_term=0.5,recurring=0.3,tactical=0.2

# Data / News API keys
FINNHUB_KEY=your_finnhub_key_here
FMP_KEY=your_fmp_key_here
NEWSAPI_KEY=your_newsapi_key_here

# Alpaca
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_FEED=iex
ALPACA_STREAM_ENABLED=true
WEBSOCKET_STREAM_FETCH_TIMEOUT_SECONDS=1.5
